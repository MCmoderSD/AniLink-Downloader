<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>

        <!-- Build -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Identity -->
        <Version>3.1.1</Version>
        <Authors>MCmoderSD</Authors>
        <Product>AniLink-Downloader</Product>

        <!-- Description -->
        <Description>Self-hosted Docker web app that downloads and unpacks single or multipart (password-protected) RAR archives with Debrid-Link and 7-Zip.</Description>

        <!-- License -->
        <Copyright>Copyright (c) 2026, Seraphin Berger</Copyright>

        <!-- Repository -->
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/MCmoderSD/AniLink-Downloader</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DlcSharp" Version="1.0.0"/>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" ExcludeAssets="runtime"/>
    </ItemGroup>

</Project>